# ========================================================
# ZORRA ROYALS (zoraaroyal.com) CONFIGURATION
# ========================================================

# 1. MongoDB Database Connection
# For Atlas: paste the FULL string from Atlas → Connect → Drivers (NOT the doc example "cluster0.abcde")
# Example shape only: mongodb+srv://USER:PASS@cluster0.REALID.mongodb.net/zorra_royals?retryWrites=true&w=majority
# For local development: mongodb://localhost:27017/zorra_royals
MONGODB_URI=mongodb://localhost:27017/zorra_royals

# 2. Security & Session Secrets
JWT_SECRET=zorra_royals_ultra_vip_jwt_secret_token_2026_royal_luxury

# 3. Domain URL
NEXT_PUBLIC_APP_URL=https://zoraaroyal.com

# 4. Geo-Lock Configuration (Set to true in dev)
BYPASS_GEO_LOCK=true

# 5. Mobile App (Capacitor) Remote Server Target
CAPACITOR_SERVER_URL=https://zoraaroyal.com

# 6. Firebase Cloud Messaging (required for APK lock-screen + server push)
# Option A: paste full service-account JSON on one line (VPS .env)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"zorra-royals",...}
# Option B: upload key file next to app on server
# FIREBASE_SERVICE_ACCOUNT_PATH=/var/www/zorra_royals/firebase-service-account.json
# After deploy: npm run test:push (checks Mongo subs + sends test FCM)
