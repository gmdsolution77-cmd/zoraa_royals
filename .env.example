# ========================================================
# ZORRA ROYALS (zoraaroyal.com) CONFIGURATION
# ========================================================

# 1. MongoDB Database Connection
# For Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/zorra_royals?retryWrites=true&w=majority
# For local development: mongodb://localhost:27017/zorra_royals
MONGODB_URI=mongodb://localhost:27017/zorra_royals

# 2. Security & Session Secrets
JWT_SECRET=zorra_royals_ultra_vip_jwt_secret_token_2026_royal_luxury

# 3. Domain URL
NEXT_PUBLIC_APP_URL=https://zoraaroyal.com

# 4. Geo-Lock Configuration (Set to true in dev)
BYPASS_GEO_LOCK=true

# 5. Mobile App (Capacitor) Remote Server Target
CAPACITOR_SERVER_URL=https://zoraaroyal.com

# 6. Firebase Service Account (JSON string or file path)
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
